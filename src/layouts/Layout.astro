---
// src/layouts/Layout.astro
import "../styles/global.css";
export interface Props {
  title: string;
}
const { title } = Astro.props;

// ═══════ VISTA PREVIA AL COMPARTIR EL LINK ═══════
// Lo que ve WhatsApp cuando se pega el link. La imagen tiene que ir con la
// URL completa (https://…), no con ruta relativa: WhatsApp no la resuelve.
// Astro.site sale de `site` en astro.config.mjs.
const OG_TITULO = "Baby Shower de Maeliz";
const OG_DESCRIPCION = "Te esperamos para celebrar la llegada de nuestra bebé.";
const OG_IMAGEN = new URL("/miniatura.jpg", Astro.site).href;
const OG_URL = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="es" class="m-0 p-0">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="only light" />
    <!-- La patita en la pestaña. Es una copia chica de pato.png recortada a
         180x180 (13 KB): el original pesa 1,6 MB y el navegador lo pide
         antes que nada. -->
    <link rel="icon" type="image/png" href="/imagenes/favicon-pato.png" />
    <link rel="apple-touch-icon" href="/imagenes/favicon-pato.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- ═══════ VISTA PREVIA AL COMPARTIR EL LINK ═══════ -->
    <!-- La imagen es /miniatura.jpg: 1200x630 y 118 KB, para que WhatsApp la
         traiga de una. Va con la URL completa, que es la única forma en que
         WhatsApp la resuelve. -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={OG_URL} />
    <meta property="og:title" content={OG_TITULO} />
    <meta property="og:description" content={OG_DESCRIPCION} />
    <meta property="og:image" content={OG_IMAGEN} />
    <meta property="og:image:secure_url" content={OG_IMAGEN} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_TITULO} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={OG_TITULO} />

    <!-- Twitter/X usa sus propias etiquetas; sin esto sale sin imagen -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={OG_TITULO} />
    <meta name="twitter:description" content={OG_DESCRIPCION} />
    <meta name="twitter:image" content={OG_IMAGEN} />

    <meta name="description" content={OG_DESCRIPCION} />
    <!-- Google Fonts: solo las tres familias que usa la invitación -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Crimson+Text:wght@400;600;700&family=Cinzel:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      /* Forzar modo claro y evitar dark mode del navegador */
      html {
        width: 100%;
        height: 100%;
        overflow-x: hidden;
        color-scheme: only light;
      }

      body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100vh;
        overflow-x: hidden;
        color-scheme: only light;
        background-color: #fbfdf8;
      }

      /* Fondo global estático para todos los componentes.
         Va como capa fija detrás del contenido (más confiable que
         background-attachment: fixed, que falla en iOS). */
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -1;
        background-image: url("/imagenes/fondoblanco.png");
        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;
        pointer-events: none;
      }

      main {
        background: transparent !important;
      }
    </style>
  </head>
  <body class="min-h-screen m-0 p-0">
    <main class="m-0 p-0 overflow-x-hidden">
      <slot />
    </main>
  </body>
</html>
