---
// src/components/Restriccion.astro
// Solo adultos: misma tarjeta del contador — rectángulo blanco con trazo rosa,
// esquinas redondeadas y las flores asomando arriba. Simple, sin recargar.
---

<section id="restriccion-section">
  <div id="rs-wrap">
    <!-- ═══════ TARJETA ═══════ -->
    <div id="rs-card">
      <!-- flores asomando en las dos esquinas de arriba -->
      <div id="rs-flor-izq"><img src="/imagenes/flor.png" alt="" /></div>
      <div id="rs-flor-der"><img src="/imagenes/flor.png" alt="" /></div>

      <!-- ── Título ── -->
      <p id="rs-solo" class="font-great-vibes">Solo</p>
      <p id="rs-adultos" class="font-cinzel">Adultos</p>

      <!-- separador dorado -->
      <div id="rs-divisor">
        <span class="rs-div-linea"></span>
        <span class="rs-div-rombo"></span>
        <span class="rs-div-linea"></span>
      </div>

      <!-- ── Texto ── -->
      <p id="rs-texto" class="font-cinzel">
        Evento exclusivo para adultos <span class="rs-emoji">🤍✨</span>
      </p>

      <p id="rs-gracias" class="font-cinzel">
        Agradecemos mucho su comprensión
      </p>
    </div>
  </div>
</section>

<style>
  #restriccion-section {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    overflow-x: hidden;
    background: transparent;
    padding: 1rem 0 1.5rem;
  }

  #rs-wrap {
    position: relative;
    width: min(100vw, 480px);
    container-type: inline-size;
  }

  #rs-wrap img {
    display: block;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  /* ═══════ TARJETA ═══════ */
  /* La misma del contador: rectángulo blanco con trazo rosa. */
  #rs-card {
    position: relative;
    z-index: 2;
    margin: 0 5cqw;
    padding: 7cqw 6cqw 6.5cqw;
    text-align: center;
    background: #ffffff;
    border: 1px solid #e5a8bd;
    border-radius: 8cqw;
    /* recorta las flores contra la curva de las esquinas */
    overflow: hidden;
  }

  /* ── Flores de las esquinas ── */
  /* En el archivo el ramo está a la izquierda, así que la de la derecha va
     volteada: el volteo en el <img> y la animación en el contenedor, porque
     GSAP escribe su propio transform. */
  #rs-flor-izq,
  #rs-flor-der {
    position: absolute;
    top: -3cqw;
    width: 40cqw;
    opacity: 0.9;
    z-index: 0;
    pointer-events: none;
  }

  #rs-flor-izq {
    left: -6cqw;
  }

  #rs-flor-der {
    right: -6cqw;
  }

  #rs-flor-izq img,
  #rs-flor-der img {
    width: 100%;
    height: auto;
  }

  #rs-flor-der img {
    transform: scaleX(-1);
  }

  /* ── Título ── */
  #rs-solo {
    position: relative;
    z-index: 2;
    margin: 0;
    font-size: 9cqw;
    line-height: 1;
    color: #e58aa6;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.85);
  }

  #rs-adultos {
    position: relative;
    z-index: 2;
    margin: 0.8cqw 0 0;
    font-size: 5.2cqw;
    line-height: 1.1;
    font-weight: 400;
    letter-spacing: 0.18em;
    /* compensa el espacio que letter-spacing deja tras la última letra */
    text-indent: 0.18em;
    text-transform: uppercase;
    color: #c08b3e;
  }

  /* ── Separador dorado ── */
  #rs-divisor {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5cqw;
    margin-top: 4.5cqw;
  }

  .rs-div-linea {
    display: block;
    width: 14cqw;
    height: 1px;
    background: rgba(192, 139, 62, 0.7);
  }

  .rs-div-rombo {
    display: block;
    width: 1.6cqw;
    height: 1.6cqw;
    transform: rotate(45deg);
    border: 1px solid #c08b3e;
    background: rgba(192, 139, 62, 0.25);
  }

  /* ── Texto ── */
  #rs-texto {
    position: relative;
    z-index: 2;
    margin: 4.5cqw auto 0;
    max-width: 66cqw;
    font-size: 3.8cqw;
    line-height: 1.7;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #4f4340;
  }

  /* los emojis no llevan versalitas ni tracking */
  .rs-emoji {
    display: inline-block;
    letter-spacing: normal;
    text-transform: none;
  }

  #rs-gracias {
    position: relative;
    z-index: 2;
    margin: 3.5cqw auto 0;
    max-width: 66cqw;
    font-size: 4.2cqw;
    line-height: 1.6;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: #e58aa6;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    // cada pieza llega desde un sitio distinto
    const inicial = () => {
      gsap.set("#rs-card", { opacity: 0, y: 26, scale: 0.96 });
      gsap.set("#rs-flor-izq", { opacity: 0, x: "-35%", y: "-30%" });
      gsap.set("#rs-flor-der", { opacity: 0, x: "35%", y: "-30%" });
      gsap.set("#rs-solo", { opacity: 0, y: -22 });
      gsap.set("#rs-adultos", { opacity: 0, y: 18 });
      gsap.set("#rs-divisor", { opacity: 0, scaleX: 0.3 });
      gsap.set("#rs-texto", { opacity: 0, x: -28 });
      gsap.set("#rs-gracias", { opacity: 0, x: 28 });
    };

    inicial();

    ScrollTrigger.create({
      trigger: "#restriccion-section",
      start: "top 82%",
      onEnter: () => {
        const tl = gsap.timeline();
        tl.to(
          "#rs-card",
          { opacity: 1, y: 0, scale: 1, duration: 1.1, ease: "power2.out" },
          0,
        )
          .to(
            ["#rs-flor-izq", "#rs-flor-der"],
            { opacity: 0.9, x: 0, y: 0, duration: 1.5, ease: "power2.out" },
            0.15,
          )
          .to(
            "#rs-solo",
            { opacity: 1, y: 0, duration: 1.4, ease: "back.out(1.2)" },
            0.25,
          )
          .to(
            "#rs-adultos",
            { opacity: 1, y: 0, duration: 1.3, ease: "power3.out" },
            0.4,
          )
          .to(
            "#rs-divisor",
            { opacity: 1, scaleX: 1, duration: 1.2, ease: "power3.out" },
            0.55,
          )
          .to(
            "#rs-texto",
            { opacity: 1, x: 0, duration: 1.3, ease: "power3.out" },
            0.7,
          )
          .to(
            "#rs-gracias",
            { opacity: 1, x: 0, duration: 1.3, ease: "power3.out" },
            0.85,
          );
      },
      onLeaveBack: inicial,
    });
  });
</script>
